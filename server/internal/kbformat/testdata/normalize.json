[
  {
    "name": "inline tags are lowercased and keep only the attributes they may have",
    "in": "Say <U>this</U> and <SPAN class=\"x\" style=\"color:red\" data-color=\"danger\">that</SPAN>.\n",
    "out": "Say <u>this</u> and <span data-color=\"danger\">that</span>.\n"
  },
  {
    "name": "a colour outside the palette is dropped",
    "in": "Read <span data-color=\"#ff0000\">this</span> <mark title=\"x\">now</mark>.\n",
    "out": "Read <span>this</span> <mark>now</mark>.\n"
  },
  {
    "name": "a wrapper writes double quotes in the canonical attribute order",
    "in": "<P data-indent='2' DATA-ALIGN='center'>\n\nHello\n\n</P>\n",
    "out": "<p data-align=\"center\" data-indent=\"2\">\n\nHello\n\n</p>\n"
  },
  {
    "name": "a heading wrapper drops an indent out of range",
    "in": "<h2 data-indent=\"9\" data-align=\"right\">\n\n## Steps\n\n</h2>\n",
    "out": "<h2 data-align=\"right\">\n\n## Steps\n\n</h2>\n"
  },
  {
    "name": "a table cell drops a span of 1 and lowercases the rest",
    "in": "<TABLE>\n<TR>\n<TD ROWSPAN=2 colspan=\"1\" data-bg=\"success\">\n\nA\n\n</TD>\n</TR>\n</TABLE>\n",
    "out": "<table>\n<tr>\n<td rowspan=\"2\" data-bg=\"success\">\n\nA\n\n</td>\n</tr>\n</table>\n"
  },
  {
    "name": "a canonical body stays byte for byte",
    "in": "# Title\n\n<p data-align=\"center\">\n\nSay <u>this</u>, <mark>that</mark> and <span data-color=\"accent\">more</span>.\n\n</p>\n\n<table>\n<tr>\n<th colspan=\"2\" data-align=\"center\">\n\nHead\n\n</th>\n</tr>\n<tr>\n<td data-bg=\"warning\">\n\nA\n\n</td>\n<td>\n\nB\n\n</td>\n</tr>\n</table>\n\n| a | b |\n| --- | --- |\n| 1 | 2 |\n",
    "out": "# Title\n\n<p data-align=\"center\">\n\nSay <u>this</u>, <mark>that</mark> and <span data-color=\"accent\">more</span>.\n\n</p>\n\n<table>\n<tr>\n<th colspan=\"2\" data-align=\"center\">\n\nHead\n\n</th>\n</tr>\n<tr>\n<td data-bg=\"warning\">\n\nA\n\n</td>\n<td>\n\nB\n\n</td>\n</tr>\n</table>\n\n| a | b |\n| --- | --- |\n| 1 | 2 |\n"
  },
  {
    "name": "a wrapper inside a list item keeps its indent",
    "in": "- item\n\n  <P DATA-ALIGN='center'>\n\n  nested <U>x</U>\n\n  </P>\n- next\n",
    "out": "- item\n\n  <p data-align=\"center\">\n\n  nested <u>x</u>\n\n  </p>\n- next\n"
  },
  {
    "name": "a wrapper inside a callout keeps its quote markers",
    "in": "> [!NOTE]\n> <P data-indent=1 data-align=right>\n>\n> in callout\n>\n> </P>\n",
    "out": "> [!NOTE]\n> <p data-align=\"right\" data-indent=\"1\">\n>\n> in callout\n>\n> </p>\n"
  },
  {
    "name": "code keeps its text",
    "in": "Type `<U>x</U>` here.\n\n```html\n<SPAN data-color='danger'>\n```\n\n    <P DATA-ALIGN='center'>\n",
    "out": "Type `<U>x</U>` here.\n\n```html\n<SPAN data-color='danger'>\n```\n\n    <P DATA-ALIGN='center'>\n"
  },
  {
    "name": "other HTML is left for the body check",
    "in": "<div class=\"x\">\n\nText <kbd>Ctrl</kbd>\n\n</div>\n",
    "out": "<div class=\"x\">\n\nText <kbd>Ctrl</kbd>\n\n</div>\n"
  },
  {
    "name": "a figure with no attributes, as a caption alone makes it, is kept as it is",
    "in": "<figure>\n\n![Alt](/api/v1/kb/images/5f0c6a52-8d1e-4b7a-9c3f-2e6d4a1b0c97)\n\n<figcaption>\n\nSettings page\n\n</figcaption>\n\n</figure>\n",
    "out": "<figure>\n\n![Alt](/api/v1/kb/images/5f0c6a52-8d1e-4b7a-9c3f-2e6d4a1b0c97)\n\n<figcaption>\n\nSettings page\n\n</figcaption>\n\n</figure>\n"
  },
  {
    "name": "an image's figure writes its attributes in one order and the border with no value",
    "in": "<FIGURE data-border=\"\" data-align='center' DATA-WIDTH=\"480\">\n\n![Alt](/api/v1/kb/images/5f0c6a52-8d1e-4b7a-9c3f-2e6d4a1b0c97)\n\n<FIGCAPTION class=\"x\">\n\nCaption\n\n</FIGCAPTION>\n\n</FIGURE>\n",
    "out": "<figure data-width=\"480\" data-align=\"center\" data-border>\n\n![Alt](/api/v1/kb/images/5f0c6a52-8d1e-4b7a-9c3f-2e6d4a1b0c97)\n\n<figcaption>\n\nCaption\n\n</figcaption>\n\n</figure>\n"
  },
  {
    "name": "a figure keeps no style attribute and no width or alignment it does not know",
    "in": "<figure style=\"float:left\" data-width=\"huge\" data-align=\"middle\" data-border=\"x\">\n\n![a](/api/v1/kb/images/5f0c6a52-8d1e-4b7a-9c3f-2e6d4a1b0c97)\n\n</figure>\n\n<figure data-width=\"5000\" data-align=\"inline\">\n\n![b](/api/v1/kb/images/5f0c6a52-8d1e-4b7a-9c3f-2e6d4a1b0c97)\n\n</figure>\n\n<figure data-width=\"0480\" data-align=\"left\">\n\n![c](/api/v1/kb/images/5f0c6a52-8d1e-4b7a-9c3f-2e6d4a1b0c97)\n\n</figure>\n",
    "out": "<figure data-border>\n\n![a](/api/v1/kb/images/5f0c6a52-8d1e-4b7a-9c3f-2e6d4a1b0c97)\n\n</figure>\n\n<figure data-align=\"inline\">\n\n![b](/api/v1/kb/images/5f0c6a52-8d1e-4b7a-9c3f-2e6d4a1b0c97)\n\n</figure>\n\n<figure data-align=\"left\">\n\n![c](/api/v1/kb/images/5f0c6a52-8d1e-4b7a-9c3f-2e6d4a1b0c97)\n\n</figure>\n"
  },
  {
    "name": "only a figure takes a width, a border, or the left and inline alignments",
    "in": "<p data-align=\"left\" data-width=\"small\" data-border>\n\nx\n\n</p>\n\n<figure data-width=\"medium\" data-indent=\"1\">\n\n![d](/api/v1/kb/images/5f0c6a52-8d1e-4b7a-9c3f-2e6d4a1b0c97)\n\n</figure>\n",
    "out": "<p>\n\nx\n\n</p>\n\n<figure data-width=\"medium\">\n\n![d](/api/v1/kb/images/5f0c6a52-8d1e-4b7a-9c3f-2e6d4a1b0c97)\n\n</figure>\n"
  },
  {
    "name": "a figure written without blank lines gets them, so its image and caption read as Markdown",
    "in": "Intro text\n<FIGURE data-width=\"480\">\n![Alt](/api/v1/kb/images/5f0c6a52-8d1e-4b7a-9c3f-2e6d4a1b0c97)\n<figcaption>\nThe **settings** page\n</figcaption>\n</figure>\nAfter it.\n",
    "out": "Intro text\n\n<figure data-width=\"480\">\n\n![Alt](/api/v1/kb/images/5f0c6a52-8d1e-4b7a-9c3f-2e6d4a1b0c97)\n\n<figcaption>\n\nThe **settings** page\n\n</figcaption>\n\n</figure>\n\nAfter it.\n"
  },
  {
    "name": "a figure's closing tag right under its image is set apart from it",
    "in": "<figure>\n\n![Alt](/api/v1/kb/images/5f0c6a52-8d1e-4b7a-9c3f-2e6d4a1b0c97)\n</figure>\n",
    "out": "<figure>\n\n![Alt](/api/v1/kb/images/5f0c6a52-8d1e-4b7a-9c3f-2e6d4a1b0c97)\n\n</figure>\n"
  },
  {
    "name": "a figure shown as code keeps its lines as they are",
    "in": "```html\n<figure>\n![Alt](/api/v1/kb/images/5f0c6a52-8d1e-4b7a-9c3f-2e6d4a1b0c97)\n</figure>\n```\n\n    <figure>\n    ![Alt](/a.png)\n    </figure>\n",
    "out": "```html\n<figure>\n![Alt](/api/v1/kb/images/5f0c6a52-8d1e-4b7a-9c3f-2e6d4a1b0c97)\n</figure>\n```\n\n    <figure>\n    ![Alt](/a.png)\n    </figure>\n"
  }
]
