{
  "name": "colliedesk-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "build": "corepack pnpm check:api && tsc --noEmit && vite build",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "typecheck": "corepack pnpm check:api && tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "e2e": "playwright test",
    "generate:api": "openapi-typescript ../contracts/openapi.yaml -o src/api/generated.ts",
    "check:api": "node scripts/check-generated-api.mjs"
  },
  "dependencies": {
    "@clerk/clerk-react": "5.61.10",
    "@codemirror/commands": "6.10.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.0",
    "@polar-sh/checkout": "0.4.3",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.35",
    "posthog-js": "1.438.12",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.14",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "27.0.1",
    "openapi-typescript": "7.10.1",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
