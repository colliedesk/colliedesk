{
  "name": "colliedesk-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "build": "corepack pnpm check:api && tsc --noEmit && vite build",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "typecheck": "corepack pnpm check:api && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "generate:api": "openapi-typescript ../contracts/openapi.yaml -o src/api/generated.ts",
    "check:api": "node scripts/check-generated-api.mjs"
  },
  "dependencies": {
    "@clerk/clerk-react": "5.55.0",
    "@fontsource-variable/geist": "5.2.8",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.35",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.14",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "27.0.1",
    "openapi-typescript": "7.10.1",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "4.0.7"
  }
}
